{
  "name": "mythos2099",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance:vacuum": "tsx src/tools/writeVacuumDuelReport.ts",
    "balance:value": "tsx src/tools/writeUnitValueReport.ts",
    "balance": "tsx src/tools/writeVacuumDuelReport.ts && tsx src/tools/writeUnitValueReport.ts",
    "balance:pdf": "tsx src/tools/writeBalancePdf.ts",
    "deploy:api": "fly deploy . --config server/fly.toml --dockerfile server/Dockerfile --yes",
    "deploy:web": "fly deploy . --config web/fly.toml --dockerfile web/Dockerfile --yes"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
